{
  "name": "dsh-companion",
  "version": "1.0.0",
  "description": "DSH 伴侣插件：手机远程（扫码配对、文字文件传输）+ 对话完成胶囊（左下角小横条卡片 / 顶部悬浮浮窗可切换、悬停看进行中与最近完成）。由 dsh-mobile-plus 与 dsh-done-pill 合并而来，路由与设置零迁移。零 DSH 源码改动。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mobile",
    "remote",
    "done-pill",
    "notification"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kr-ATG/dsh-companion.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "public",
    "scripts",
    "build.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "LICENSE-MIT",
    "NOTICE",
    "AGENTS.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "smoke": "node scripts/smoke-host.mjs && node scripts/smoke-client.mjs",
    "smoke:host": "node scripts/smoke-host.mjs",
    "smoke:client": "node scripts/smoke-client.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "(Apache-2.0 AND MIT)"
}
